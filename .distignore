# Files and directories that must NOT ship to wp.org (applied by the 10up
# deploy action and by the release zip step). Built assets under assets/ ARE
# shipped — generated outputs are untracked (gitignored) and rebuilt fresh in CI.
#
# IMPORTANT: generic dir names (src, bin, tests, build) are ANCHORED with a
# leading slash so they only match the PLUGIN's own top-level dirs. Without the
# anchor, rsync/10up match them at any depth and would strip required vendor
# paths like vendor/wedevs/wp-utils/src (SingletonTrait) -> fatal on activation.

# Plugin-local source / tooling dirs (root-anchored)
/.git
/.github
/.claude
/.wordpress-org
/src
/bin
/tests
/tools
/build
/node_modules
/assets/less

# The user-directory module's own npm project: ship its PHP and views, not its
# build setup (its bundle is built into assets/).
/modules/user-directory/node_modules
/modules/user-directory/package.json
/modules/user-directory/package-lock.json
/modules/user-directory/webpack.config.js
/modules/user-directory/tailwind.config.js

# Local work folders that can sit in a checkout (never in git, never shipped)
/dist
/.playwright-mcp
/openspec
/qa-stories
/RELEASE_NOTES.md

# Dotfiles / dev config (root-anchored)
/.babelrc
/.editorconfig
/.eslintrc
/.eslintrc.js
/.eslintrc.json
/.prettierrc
/.gitignore
/.gitattributes
/.distignore
/.nvmrc
/.travis.yml
/.phpunit.result.cache
/phpcs.xml
/phpcs.xml.dist
/phpunit.xml
/phpunit.xml.dist
/state.json

# Build / tooling config (root-anchored)
/Gruntfile.js
/gruntfile.js
/vite.config.mjs
/vite.config.js
/webpack.admin.config.js
/webpack.config.js
/webpack.wpuf-externals.js
/webpack.frontend.config.js
/tailwind.config.js
/postcss.config.js
/postcss.user-directory.config.js
/postcss.config.admin.js
/postcss.config.frontend.js
/package.json
/package-lock.json
/pnpm-lock.yaml
/pnpm-workspace.yaml
/composer.json
/composer.lock
/appsero.json
/plugin-deploy.sh

# Docs (root-anchored)
/readme.md
/README.md
/CHANGELOG.md
/CLAUDE.md
/docs

# Match anywhere (safe: none of these is needed at runtime, vendor included)
.DS_Store
*.zip
*.log
*.map
CLAUDE.md
AGENTS.md
