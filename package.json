{
  "name": "wp-user-frontend",
  "version": "4.3.13",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "description": "A Frontend Plugin for WordPress",
  "author": "Tareq Hasan",
  "license": "GPL",
  "private": true,
  "scripts": {
    "release": "grunt release",
    "build": "npm run build:css && npm run build:form-builder && npm run build:forms-list-react && npm run build:subscriptions && npm run build:frontend-subscriptions && npm run build:ai-form-builder && npm run build:account && npm run build:user-directory && npm run build:blocks && npm run build:legacy && npm run build:css",
    "build:blocks": "wp-scripts build --config webpack.config.js",
    "watch:blocks": "wp-scripts start --config webpack.config.js",
    "build:legacy": "grunt less && grunt uglify",
    "build:form-builder": "webpack --config admin/form-builder/webpack.config.js --mode=production",
    "dev:form-builder": "webpack --config admin/form-builder/webpack.config.js --watch --mode=development",
    "build:forms-list-react": "webpack --config admin/forms-list/webpack.config.js --mode=production",
    "dev:forms-list-react": "webpack --config admin/forms-list/webpack.config.js --watch --mode=development",
    "build:subscriptions": "wp-scripts build --config webpack.subscriptions.config.js",
    "watch:subscriptions": "wp-scripts start --config webpack.subscriptions.config.js",
    "build:frontend-subscriptions": "ENTRY=frontend-subscriptions vite build",
    "build:ai-form-builder": "ENTRY=ai-form-builder vite build",
    "build:user-directory": "cd modules/user-directory && npm ci && npm run build",
    "dev:user-directory": "cd modules/user-directory && npm ci && npm run dev",
    "build:css": "grunt tailwind && grunt tailwind-minify",
    "build:account": "ENTRY=account vite build",
    "test:form-builder": "jest --config admin/form-builder/jest.config.js"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@tailwindcss/forms": "0.5.7",
    "@types/node": "^18.11.18",
    "@vitejs/plugin-vue": "^5.0.4",
    "@wordpress/scripts": "^31.8.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^6.23.0",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.2.1",
    "daisyui": "^4.12.2",
    "grunt": "^1.6.3",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-compress": "^2.0.0",
    "grunt-contrib-concat": "^2.1.0",
    "grunt-contrib-copy": "~1.0.0",
    "grunt-contrib-imagemin": "^4.0.0",
    "grunt-contrib-jshint": "^3.2.0",
    "grunt-contrib-less": "^3.0.0",
    "grunt-contrib-uglify": "^5.2.2",
    "grunt-contrib-watch": "^1.1.0",
    "grunt-notify": "^0.4.5",
    "grunt-phplint": "^0.1.0",
    "grunt-postcss": "^0.9.0",
    "grunt-shell": "^4.0.0",
    "grunt-text-replace": "^0.4.0",
    "grunt-wp-i18n": "^1.0.4",
    "grunt-wp-readme-to-markdown": "^2.1.0",
    "jshint-stylish": "^2.2.1",
    "postcss": "^8.4.31",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.3.5",
    "vitawind": "^2.3.0",
    "vite": "^5.1.4",
    "tailwindcss-scoped-preflight": "^3.4.12",
    "jest": "^29.7.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^1.7.18",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/react": "^2.1.1",
    "@heroicons/vue": "^2.1.1",
    "@vueform/multiselect": "^2.6.8",
    "@vuepic/vue-datepicker": "^8.2.0",
    "@wordpress/api-fetch": "^6.49.0",
    "@wordpress/compose": "^7.20.0",
    "@wordpress/data": "^10.20.0",
    "@wordpress/element": "^6.20.0",
    "@wordpress/hooks": "^4.20.0",
    "@wordpress/i18n": "^4.52.0",
    "@wordpress/icons": "^11.6.0",
    "@wordpress/router": "^1.37.0",
    "array-uniq": "^3.0.0",
    "cli": "^1.0.1",
    "clsx": "^2.1.0",
    "epic-spinners": "^2.0.0",
    "pinia": "^2.1.7",
    "react": "^18.3.1",
    "react-datepicker": "^6.0.0",
    "react-dom": "^18.3.1",
    "react-select": "^5.8.0",
    "vue": "^3.4.19",
    "vue-router": "^4.3.2"
  }
}
