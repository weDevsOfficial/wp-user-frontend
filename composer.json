{
  "name": "wedevs/wp-user-frontend",
  "description": "A Frontend Plugin for WordPress",
  "type": "wordpress-plugin",
  "license": "GPLv2",
  "authors": [
    {
      "name": "Tareq Hasan",
      "email": "tareq@wedevs.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=7.4",
    "composer/installers": ">=1.4",
    "wedevs/wp-utils": "^1.1"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.4.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "tareq1988/wp-php-cs-fixer": "dev-master",
    "phpcompatibility/phpcompatibility-wp": "^2.1.8",
    "phpunit/phpunit": "9.6.37",
    "yoast/phpunit-polyfills": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "WeDevs\\Wpuf\\": "includes/",
      "WeDevs\\Wpuf\\Lib\\": "Lib/"
    }
  },
  "scripts": {
    "phpcs": [
      "phpcs -p -s"
    ],
    "phpcbf": [
      "phpcbf -p"
    ],
    "test": "phpunit",
    "test:install": "tests/php/bin/install-wp-tests.sh wpuf_tests root '' localhost latest"
  },
  "config": {
    "platform": {
      "php": "7.4"
    },
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
